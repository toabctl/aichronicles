[Unit]
Description=aichronicles ingest socket

[Socket]
# %t = $XDG_RUNTIME_DIR (typically /run/user/<uid>), tmpfs, per-user.
# Matches what paths.Socket() resolves to when XDG_RUNTIME_DIR is set.
ListenStream=%t/aichronicles/sock
SocketMode=0600
DirectoryMode=0700
# Tear the socket down between stops so a stale path never lingers.
RemoveOnStop=true

[Install]
WantedBy=sockets.target
