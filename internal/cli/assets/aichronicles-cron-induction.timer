[Unit]
Description=aichronicles induction sweep timer

[Timer]
# Mirrors the daemon-resident sweeper's cadence (15 minutes between
# runs). OnUnitInactiveSec is "gap between runs" rather than a
# wall-clock-aligned schedule (OnCalendar) — same shape as the Go
# time.Ticker the goroutine used. OnBootSec=2min keeps a fresh
# boot from immediately spending on a 5-LLM-call sweep; flip to 0
# for fire-immediately-on-boot behaviour.
#
# Persistent=true makes systemd run a missed timer ASAP after wakeup
# so a powered-off laptop doesn't leave idle sessions un-induced.
OnBootSec=2min
OnUnitInactiveSec=15min
Persistent=true
Unit=aichronicles-cron-induction.service

[Install]
WantedBy=timers.target
