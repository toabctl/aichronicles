[Unit]
Description=aichronicles induction sweep timer

[Timer]
# Twice a day (09:00 and 21:00 local). Summarising idle sessions is
# not latency-sensitive — a session settled hours ago is just as
# summarisable now as in 15 minutes — and a tighter cadence only
# burned LLM tokens polling a mostly-empty backlog. The --since
# window on the sweep (and `summaries fill`) means nothing is lost
# between runs; a missed window is just a slightly larger next batch.
#
# Persistent=true makes systemd run a missed timer ASAP after wakeup
# so a powered-off laptop doesn't leave idle sessions un-induced.
OnCalendar=*-*-* 09,21:00:00
Persistent=true
Unit=aichronicles-cron-induction.service

[Install]
WantedBy=timers.target
