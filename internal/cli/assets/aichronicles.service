[Unit]
Description=aichronicles ingest daemon
Requires=aichronicles.socket
After=aichronicles.socket

[Service]
# systemd's spawned-service environment does not reliably inherit the
# user manager's PATH, so we reference the binary by absolute path via
# the %h (home) specifier. The XDG convention ~/.local/bin is assumed.
ExecStart=%h/.local/bin/aichroniclesd
Type=simple
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
